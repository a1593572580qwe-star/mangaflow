# ==============================================================================
# MangaFlow 漫画分镜工坊 - 环境变量配置示例 (.env.example)
#
# 使用方式：
# 1. 复制本文件并重命名为 .env.local：
#    Windows PowerShell: Copy-Item .env.example .env.local
#    macOS / Linux:      cp .env.example .env.local
# 2. 在 .env.local 中填入您的真实 API 配置（.env.local 会被 Git 自动忽略，切勿提交到代码库）。
# 3. 若留空 STORYBOARD_API_KEY，系统将自动进入内置【演示模式】，无需网络与密钥亦可体验核心功能。
# ==============================================================================

# 【必填/选填】兼容 OpenAI 协议的 API 端点 Base URL
# 常用端点示例：
# - OpenAI 官方:    https://api.openai.com/v1
# - DeepSeek:       https://api.deepseek.com
# - Moonshot (Kimi): https://api.moonshot.cn/v1
# - 阿里云通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# - 智谱 GLM:       https://open.bigmodel.cn/api/paas/v4
# - 本地 Ollama:    http://localhost:11434/v1
STORYBOARD_BASE_URL=https://api.openai.com/v1

# 【选填】您的 AI API 密钥
# 注意：切勿在此提交真实密钥！留空则默认进入免 Key 演示模式。
STORYBOARD_API_KEY=

# 【选填】使用的语言模型名称
# 示例：gpt-4o-mini, gpt-4o, deepseek-chat, moonshot-v1-8k, qwen-turbo
STORYBOARD_MODEL=gpt-4o-mini
